{
  "entities": {
    "Run": {
      "title": "Run",
      "description": "An organized group run hosted by a club member",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "meetLocation": { "type": "string", "minLength": 2, "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "distanceKm": { "type": "number" },
        "paceGroup": { "type": "string", "maxLength": 50 },
        "terrain": { "type": "string", "enum": ["road", "trail", "track", "mixed"] },
        "elevationGainM": { "type": "number" },
        "maxRunners": { "type": "number" },
        "organizerId": { "type": "string", "maxLength": 128 },
        "organizerName": { "type": "string", "maxLength": 100 },
        "organizerPhoto": { "type": "string", "maxLength": 500 },
        "postRunSocial": { "type": "string", "maxLength": 200 },
        "routeHighlights": { "type": "array" },
        "rsvpCount": { "type": "number" },
        "rsvpUserIds": { "type": "array" },
        "attendees": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "date", "time", "meetLocation", "distanceKm", "organizerId", "organizerName"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile and running preferences of a club member",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "preferredPace": { "type": "string", "maxLength": 50 },
        "favoriteDistance": { "type": "string", "maxLength": 50 },
        "shoes": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "RunComment": {
      "title": "RunComment",
      "description": "Discussion comment on a run event",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhoto": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["runId", "userId", "userName", "text"]
    },
    "SavedRoute": {
      "title": "SavedRoute",
      "description": "A favorite running route saved in the club route library",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "distanceKm": { "type": "number" },
        "difficulty": { "type": "string", "enum": ["easy", "moderate", "challenging", "elite"] },
        "startLocation": { "type": "string", "minLength": 2, "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "elevationGainM": { "type": "number" },
        "terrain": { "type": "string", "enum": ["road", "trail", "track", "mixed"] },
        "description": { "type": "string", "maxLength": 1000 },
        "landmarks": { "type": "array" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "distanceKm", "difficulty", "startLocation", "creatorId", "creatorName"]
    }
  },
  "firestore": {
    "/runs/{runId}": {
      "schema": "Run",
      "description": "Collection of scheduled running club events"
    },
    "/runs/{runId}/comments/{commentId}": {
      "schema": "RunComment",
      "description": "Community chat and questions about an upcoming run"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Member profile information"
    },
    "/routes/{routeId}": {
      "schema": "SavedRoute",
      "description": "Community curated favorite running routes"
    }
  }
}
